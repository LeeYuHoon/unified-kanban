#!/bin/bash
# 신뢰하는 OS Python은 저장소/인터프리터 실행 전에 내장 검증 코드만 실행한다.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  printf '%s\n' 'Execute this launcher; do not source it.' >&2
  return 2
fi
set -euo pipefail
# BEGIN EMBEDDED NAMESPACE (회귀 테스트로 동일성 유지)
exec /usr/bin/python3 -I -S -B -c '"""읽기 전용 이름 공간 신뢰 검증. root/현재 UID를 신뢰하며 권한은 복구하지 않는다.

표준 라이브러리만 사용하는 이 모듈을 셸 부트스트랩에도 그대로 내장하여
이름 공간 검증 전에 저장소나 선택한 인터프리터의 코드가 실행되지 않게 한다.
"""
import ctypes
import errno
import os
from pathlib import Path
import stat
import sys


def acl_text(fd):
    """검증 중인 바로 그 파일 디스크립터에서 Darwin 확장 ACL을 읽는다."""
    if sys.platform != '"'"'darwin'"'"':
        # Linux의 POSIX ACL 쓰기 권한은 그룹 모드 마스크로 제한된다.
        if not sys.platform.startswith('"'"'linux'"'"'):
            raise PermissionError('"'"'unsupported ACL platform'"'"')
        return '"'"''"'"'
    libc = ctypes.CDLL(None, use_errno=True)
    libc.acl_get_fd_np.argtypes = [ctypes.c_int, ctypes.c_int]
    libc.acl_get_fd_np.restype = ctypes.c_void_p
    libc.acl_to_text.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ssize_t)]
    libc.acl_to_text.restype = ctypes.c_void_p
    libc.acl_free.argtypes = [ctypes.c_void_p]
    acl = libc.acl_get_fd_np(fd, 0x100)
    if not acl:
        error = ctypes.get_errno()
        if error == errno.ENOENT:
            return '"'"''"'"'
        raise OSError(error, os.strerror(error))
    text = None
    try:
        length = ctypes.c_ssize_t()
        text = libc.acl_to_text(acl, ctypes.byref(length))
        if not text:
            raise PermissionError('"'"'ACL unreadable'"'"')
        return ctypes.string_at(text, length.value).decode('"'"'utf-8'"'"', errors='"'"'strict'"'"')
    finally:
        if text:
            libc.acl_free(text)
        libc.acl_free(acl)


def validate_fd(fd, *, private=False, sticky=False):
    info = os.fstat(fd)
    if info.st_uid not in {0, os.getuid()}:
        raise PermissionError('"'"'foreign namespace owner'"'"')
    if info.st_mode & 0o022:
        if not (sticky and info.st_uid == 0 and stat.S_ISDIR(info.st_mode)
                and info.st_mode & stat.S_ISVTX):
            raise PermissionError('"'"'public namespace write'"'"')
    # 보수적 정책: 비공개 상태는 모든 ACE를 거부한다. 다른 곳에서는
    # 거부 전용 ACL(예: macOS everyone deny delete)만 허용하고 허용 ACE는 모두 거부한다.
    for entry in acl_text(fd).splitlines():
        entry = entry.strip()
        if not entry or entry == '"'"'!#acl 1'"'"':
            continue
        if private or '"'"':deny:'"'"' not in entry or '"'"':allow:'"'"' in entry:
            raise PermissionError('"'"'untrusted extended ACL'"'"')
    return info


def canonical(path):
    path = Path(path)
    if not path.is_absolute() or '"'"'..'"'"' in path.parts:
        raise ValueError('"'"'absolute namespace required'"'"')
    if sys.platform == '"'"'darwin'"'"' and len(path.parts) > 1 and path.parts[1] in {'"'"'var'"'"', '"'"'tmp'"'"', '"'"'etc'"'"'}:
        path = Path('"'"'/private'"'"', *path.parts[1:])
    return path


def open_directory(path):
    path = canonical(path)
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    fd = os.open('"'"'/'"'"', flags)
    try:
        validate_fd(fd)
        current = Path('"'"'/'"'"')
        for part in path.parts[1:]:
            child = os.open(part, flags, dir_fd=fd)
            os.close(fd)
            fd = child
            current /= part
            # OS 소유 임시 루트에만 sticky 예외를 적용한다.
            validate_fd(fd, sticky=str(current) in {'"'"'/tmp'"'"', '"'"'/private/tmp'"'"'})
        return fd
    except BaseException:
        os.close(fd)
        raise


def trusted_file(path, *, links=False):
    """인터프리터 링크를 해석하기 전에 각 말단 링크와 부모를 검증한다."""
    path = canonical(path)
    for _ in range(40):
        if links:
            # 인터프리터/설치 경로에 링크가 있을 수 있지만 대상 경로를 읽기 전에
            # 각 링크를 포함하는 디렉터리를 신뢰할 수 있어야 한다.
            restart = False
            for index in range(1, len(path.parts)):
                prefix = Path(*path.parts[:index + 1])
                parent_fd = open_directory(prefix.parent)
                try:
                    info = os.stat(prefix.name, dir_fd=parent_fd, follow_symlinks=False)
                    if stat.S_ISLNK(info.st_mode):
                        if info.st_uid not in {0, os.getuid()}:
                            raise PermissionError('"'"'foreign link'"'"')
                        target = os.readlink(prefix.name, dir_fd=parent_fd)
                        path = canonical(os.path.abspath(prefix.parent / target / Path(*path.parts[index + 1:])))
                        restart = True
                        break
                finally:
                    os.close(parent_fd)
            if restart:
                continue
        parent = open_directory(path.parent)
        try:
            info = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
            if stat.S_ISLNK(info.st_mode) and links:
                if info.st_uid not in {0, os.getuid()}:
                    raise PermissionError('"'"'foreign link'"'"')
                target = os.readlink(path.name, dir_fd=parent)
                # 상대 인터프리터 링크는 ..을 사용할 수 있다. 포함하는 이름 공간과
                # 링크 소유자를 검증한 뒤에만 정규화한다.
                path = canonical(os.path.abspath(path.parent / target))
                continue
            fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=parent)
            try:
                opened = validate_fd(fd)
                if not stat.S_ISREG(opened.st_mode) or opened.st_mode & (stat.S_ISUID | stat.S_ISGID):
                    raise PermissionError('"'"'unsafe executable/source'"'"')
            finally:
                os.close(fd)
            return path
        finally:
            os.close(parent)
    raise PermissionError('"'"'link depth exceeded'"'"')

try:
    entry = trusted_file(os.path.abspath(sys.argv[1]), links=True)
    repo = entry.parent.parent
    interpreter = trusted_file(repo / '"'"'.venv/bin/python'"'"', links=True)
    source = repo / '"'"'src/kanban_adapter'"'"'
    fd = open_directory(source)
    os.close(fd)
    # 저장소에서 가져오기를 허용하기 전에 가져올 수 있는 소스와 바이트코드를 검사한다.
    for directory, dirs, files in os.walk(source, followlinks=False):
        fd = open_directory(directory)
        os.close(fd)
        for name in dirs:
            fd = open_directory(Path(directory) / name)
            os.close(fd)
        for name in files:
            trusted_file(Path(directory) / name)
    code = '"'"'import runpy,sys; sys.path.insert(0,sys.argv.pop(1)); runpy.run_module("kanban_adapter.conversation_launch",run_name="__main__")'"'"'
    os.execv(str(interpreter), [str(interpreter), '"'"'-I'"'"', '"'"'-S'"'"', '"'"'-B'"'"', '"'"'-c'"'"', code, str(repo / '"'"'src'"'"'), *sys.argv[2:]])
except (OSError, ValueError, RuntimeError):
    print('"'"'Native launch refused: untrusted bootstrap namespace.'"'"', file=sys.stderr)
    sys.exit(2)
' "$0" "$@"
